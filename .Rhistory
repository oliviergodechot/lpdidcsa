data=df,
unit = "id", time = "t",
dependent = "log_earnings",
meth = method,
controls = "female",
type_horizon = par_type_horizon,
one_reg = par_one_reg
)
},
iterations = min_iterations,
check = FALSE  # Désactive la vérification des résultats identiques
)
# Retourne un résumé simplifié
list(
method = method,
median_time = result$median,  # Temps médian en secondes
memory = result$mem_alloc,  # Mémoire allouée en Mo
iterations = result$n_itr          # Nombre d'itérations effectuées
)
}, error = function(e) {
message(paste("Erreur pour la méthode", method, ":", e$message))
return(NULL)
})
}
