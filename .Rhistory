mean_time = mean(result$bench_time) / 1e9,      # Temps moyen en secondes
sd_time = sd(result$bench_time) / 1e9,          # Écart-type en secondes
memory = median(result$mem_alloc) / 1e6,  # Mémoire allouée en Mo
iterations = length(result$bench_time)          # Nombre d'itérations effectuées
)
}, error = function(e) {
message(paste("Erreur pour la méthode", method, ":", e$message))
return(NULL)
})
}
# Exemple d'utilisation
methods <- c("lpdid", "lpdid_rw", "lpdid_ipw", "lpcsa", "lpcsa_ipw")
results <- list()
for (method in methods) {
cat("Benchmarking méthode:", method, "\n")
results[[method]] <- bench_method(
df = ton_dataframe,
method = method,
par_type_horizon = "wide",  # ou "long"
par_one_reg = FALSE,
min_iterations = 3
)
}
# Afficher les résultats sous forme de tableau
results_df <- rbindlist(results, idcol = "method")
print(results_df[, .(method, median_time, mean_time, sd_time, memory, iterations)])
