format(object.size(toydata),units="Mb")
toydata <- toydata[,list(id,t,firm_id,female,treat,log_earnings,g_i)]
toydata[,g_i:=fifelse(is.na(g_i),0,g_i)]
# Format wide -------------------------------
par_type_horizon <- "wide"
par_one_reg <- F
min_iterations <- 2
## Wide horizon database ---------------------
